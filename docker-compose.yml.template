version: '3'

services:
  backend:
    build:
      context: backend
      dockerfile: Dockerfile
    environment:
      # Optional: contact address sent to Nominatim (OSM geocoding usage policy)
      - NOMINATIM_EMAIL=
  frontend:
    build:
      context: pvtools
      dockerfile: Dockerfile
      args:
        - APP_URL=http://localhost:8888
        # Google Analytics 4 measurement ID (G-...), leave empty to disable
        - GOOGLE_ANALYTICS_ID=
  proxy:
    image: nginx:alpine
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf
    ports:
      - 8888:80
    restart: unless-stopped

